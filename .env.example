# ---------------------------------------------------------------------------
# CampusFlow environment configuration
# Copy to `.env` (or `.env.local`) and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# GEMINI_API_KEY
# Required for the Campus AI Concierge and the Veo video animator.
# Without it those two features return a clear "not configured" error and
# every other feature keeps working.
GEMINI_API_KEY=""

# APP_URL
# Public URL where the app is hosted. Used for self-referential links.
APP_URL=""

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# CAMPUSFLOW_SESSION_SECRET  (REQUIRED in production)
# HMAC key used to sign session cookies. Must be at least 16 characters.
# Every server instance must share the SAME value, otherwise a session cookie
# issued by one instance is rejected by the next.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CAMPUSFLOW_SESSION_SECRET=""

# CAMPUSFLOW_DEMO_AUTH
# Set to "false" to disable the built-in demo passwords on the sign-in screen.
# Recommended for any real deployment; give users real passwords via
# db.setUserPassword() instead.
CAMPUSFLOW_DEMO_AUTH="true"

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY
# Supabase project URL and publishable (anon) key. Both are read by the
# browser client only — the VITE_ prefix is what exposes them to the bundle,
# which is safe for the publishable key alone because RLS is the real
# permission boundary.
#
# NOTE: nothing in the server calls dotenv.config(), so `.env` currently reaches
# the CLIENT (Vite loads VITE_* automatically) and NOT the Express process.
# Server-side Supabase calls need a real process env var (no VITE_ prefix).
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# ---------------------------------------------------------------------------
# Firebase (Google sign-in + product telemetry)
# ---------------------------------------------------------------------------
# VITE_FIREBASE_* — Firebase web app config.
#
# Two separate uses, do not conflate them:
#
#   1. AUTHENTICATION — "Continue with Google". The browser signs in with the
#      Google provider via Firebase Auth and posts the resulting Firebase ID
#      token to POST /api/auth/firebase. Needed by the button: API_KEY,
#      AUTH_DOMAIN, PROJECT_ID and APP_ID. Without all four the button does not
#      render and the password form remains the only way in.
#
#   2. PRODUCT TELEMETRY — page views, sessions, click paths. Developer-facing,
#      about how the app is used. Disabled unless
#      VITE_FIREBASE_MEASUREMENT_ID is set.
#
# Neither is the app's own analytics: `AdminAnalytics.tsx` and
# `GET /api/analytics` are campus KPIs (wait times, throughput, capacity
# simulation) shown to staff and admin, computed from server/db.ts. Different
# audience, different data, different name in the UI.
#
# Firebase client config is public by design; access is governed by Firebase
# security rules, exactly like the Supabase publishable key above. It is still
# kept in env rather than inlined, so rotating the project does not mean a code
# change.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# ---------------------------------------------------------------------------
# Firebase Auth — SERVER side. Load-bearing, read this before changing.
# ---------------------------------------------------------------------------
# CAMPUSFLOW_FIREBASE_PROJECT_ID — the one Firebase project whose identity
# tokens this deployment will accept. Leave blank to disable Google sign-in:
# POST /api/auth/firebase then answers 503 and the verifier refuses every token.
#
# No VITE_ prefix on purpose. Nothing in the server calls dotenv.config(), so a
# .env file reaches the browser build only; this must be a real process
# environment variable (Vercel project setting, or exported in the shell).
#
# This value is a security boundary, not a UI setting. Every Firebase project on
# the internet signs with keys from ONE shared JWKS endpoint, so a valid
# signature proves only that *some* Firebase project signed the token. The
# audience and issuer checks in server/firebase-auth.ts compare against this
# project id, and that comparison is what stops a token minted by an attacker's
# own Firebase project — for an email like admin@galgotiasuniversity.invalid — from being
# accepted here. Changing this value does not need a code change; removing it
# disables the feature safely.
CAMPUSFLOW_FIREBASE_PROJECT_ID=""

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# CAMPUSFLOW_DATA_DIR
# Where the campus database and traffic history are written.
#   - Unset (default): ./data when writable, otherwise a temp directory.
#   - Set: always this directory. Used by the test harness for isolation.
# NOTE: serverless platforms ship a read-only bundle, so the data falls back to
# ephemeral storage and is reported as "storage":"ephemeral" by /api/health.
# See README "Deployment" for how to get durable storage.
CAMPUSFLOW_DATA_DIR=""

# PORT
# Port for the local/dev server. Defaults to 3000.
PORT=3000
